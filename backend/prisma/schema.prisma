generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  envelopes  Envelope[]
  transactions Transaction[]
  budgetMonths  BudgetMonth[] 
}

model Envelope {
  id              Int              @id @default(autoincrement())
  name            String

  userId          Int
  user            User             @relation(fields: [userId], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  transactions     Transaction[]
  budgetMovements  BudgetMovement[]
  envelopeMonths   EnvelopeMonth[]

  @@unique([userId, name])
}

model EnvelopeMonth {
  id          Int      @id @default(autoincrement())

  envelopeId  Int
  envelope    Envelope @relation(fields: [envelopeId], references: [id])

  month       DateTime

  isActive    Boolean  @default(true)

  budgeted    Float    @default(0)
  activity    Float    @default(0)
  available   Float    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([envelopeId, month])
  @@index([envelopeId, month])
}

model BudgetMonth {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  month     DateTime 
  income    Float    @default(0)
  assigned  Float    @default(0)
  toAssign  Float    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month])
  @@index([userId, month])
}

model Transaction {
  id          Int       @id @default(autoincrement())
  amount      Float     
  description String
  date        DateTime  @default(now())

  userId      Int
  user        User      @relation(fields: [userId], references: [id])

  envelopeId  Int?
  envelope    Envelope? @relation(fields: [envelopeId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
  @@index([envelopeId])
}

model BudgetMovement {
  id          Int      @id @default(autoincrement())
  envelopeId  Int
  envelope    Envelope @relation(fields: [envelopeId], references: [id])
  amount      Float
  type        BudgetMovementType
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum BudgetMovementType {
  ALLOCATION   
  REALLOCATION 
}
